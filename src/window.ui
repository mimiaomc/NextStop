<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="NextstopWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">NextStop - Universal Transit Announcement Simulator</property>
    <property name="default-width">860</property>
    <property name="default-height">720</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkDropDown" id="pack_dropdown">
                    <property name="tooltip-text" translatable="yes">Switch announcement pack</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="import_pack_btn">
                    <property name="icon-name">list-add-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Import announcement pack (.zip)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="refresh_pack_btn">
                    <property name="icon-name">view-refresh-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Refresh audio library</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="title-widget">
              <object class="AdwViewSwitcherTitle" id="switcher_title">
                <property name="stack">view_stack</property>
                <property name="title" translatable="yes">NextStop Broadcaster</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="GtkStack" id="main_stack">
                <property name="transition-type">crossfade</property>

                <!-- Page A: Main Operator View (When packs are loaded) -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">content</property>
                    <property name="child">
                      <object class="AdwViewStack" id="view_stack">

                        <!-- Tab 1: Daily Dispatch -->
                        <child>
                          <object class="AdwViewStackPage">
                            <property name="name">daily</property>
                            <property name="title" translatable="yes">Daily Dispatch</property>
                            <property name="icon-name">mark-location-symbolic</property>
                            <property name="child">
                              <object class="AdwPreferencesPage">
                                <child>
                                  <object class="AdwPreferencesGroup" id="depart_group">
                                    <property name="title" translatable="yes">Depart / Next Station Broadcast</property>
                                    <property name="description" translatable="yes">Start alert, next stop notice, transfers and station specials</property>
                                    <child>
                                      <object class="AdwEntryRow" id="depart_station_entry">
                                        <property name="title" translatable="yes">Next Station</property>
                                        <property name="text"></property>
                                        <child type="suffix">
                                          <object class="GtkDropDown" id="depart_station_dropdown">
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">Select existing station from library</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwEntryRow" id="depart_intro_entry">
                                        <property name="title" translatable="yes">Station Feature Intro (Optional)</property>
                                        <property name="text"></property>
                                        <child type="suffix">
                                          <object class="GtkButton" id="depart_intro_clear_btn">
                                            <property name="valign">center</property>
                                            <property name="icon-name">edit-clear-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Clear intro (do not broadcast)</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkDropDown" id="depart_intro_dropdown">
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">Select intro from library</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwExpanderRow" id="depart_transfer_expander">
                                        <property name="title" translatable="yes">Transfer Lines</property>
                                        <property name="subtitle" translatable="yes">No transfer</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwComboRow" id="depart_ad_row">
                                        <property name="title" translatable="yes">Commercial Ad</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="AdwPreferencesGroup" id="arrive_group">
                                    <property name="title" translatable="yes">Arrive / Approaching Broadcast</property>
                                    <property name="description" translatable="yes">Arrival chime, commercials and rear door exit notice</property>
                                    <child>
                                      <object class="AdwEntryRow" id="arrive_station_entry">
                                        <property name="title" translatable="yes">Arriving Station</property>
                                        <property name="text"></property>
                                        <child type="suffix">
                                          <object class="GtkButton" id="arrive_sync_btn">
                                            <property name="valign">center</property>
                                            <property name="icon-name">edit-copy-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Sync from Next Station</property>
                                            <style>
                                              <class name="flat"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkDropDown" id="arrive_station_dropdown">
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">Select existing station from library</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwComboRow" id="arrive_chime_row">
                                        <property name="title" translatable="yes">Arrival Chime</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwComboRow" id="arrive_ad_row">
                                        <property name="title" translatable="yes">Commercial Ad</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="AdwPreferencesGroup" id="outside_group">
                                    <property name="title" translatable="yes">Outside Arrival Broadcast</property>
                                    <property name="description" translatable="yes">External loudspeaker: safety notice, line name and destination</property>
                                    <child>
                                      <object class="AdwEntryRow" id="outside_line_entry">
                                        <property name="title" translatable="yes">Route / Line</property>
                                        <property name="text"></property>
                                        <child type="suffix">
                                          <object class="GtkDropDown" id="outside_line_dropdown">
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">Select existing line from library</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwEntryRow" id="outside_dest_entry">
                                        <property name="title" translatable="yes">Destination</property>
                                        <property name="text"></property>
                                        <child type="suffix">
                                          <object class="GtkDropDown" id="outside_dest_dropdown">
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">Select existing station from library</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow">
                                        <property name="title" translatable="yes">Play Outside Arrival Broadcast</property>
                                        <property name="subtitle" translatable="yes">Play safety reminder and route destination via outside speaker</property>
                                        <child type="suffix">
                                          <object class="GtkButton" id="outside_play_btn">
                                            <property name="label" translatable="yes">Broadcast Outside</property>
                                            <property name="icon-name">audio-volume-high-symbolic</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="suggested-action"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>

                        <!-- Tab 2: Vehicle & Features -->
                        <child>
                          <object class="AdwViewStackPage">
                            <property name="name">features</property>
                            <property name="title" translatable="yes">Vehicle &amp; Features</property>
                            <property name="icon-name">emblem-system-symbolic</property>
                            <property name="child">
                              <object class="AdwPreferencesPage">
                                <child>
                                  <object class="AdwPreferencesGroup" id="global_switches_group">
                                    <property name="title" translatable="yes">Vehicle &amp; System Features</property>
                                    <property name="description" translatable="yes">Global broadcast switches defined by current pack.json</property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>

                        <!-- Tab 3: Terminus & Route -->
                        <child>
                          <object class="AdwViewStackPage">
                            <property name="name">special</property>
                            <property name="title" translatable="yes">Terminus &amp; Route</property>
                            <property name="icon-name">audio-speakers-symbolic</property>
                            <property name="child">
                              <object class="AdwPreferencesPage">
                                <child>
                                  <object class="AdwPreferencesGroup">
                                    <property name="title" translatable="yes">Origin Departure Broadcast</property>
                                    <property name="description" translatable="yes">Full line introduction, welcome message, origin and destination</property>
                                    <child>
                                      <object class="AdwComboRow" id="first_line_row">
                                        <property name="title" translatable="yes">Operating Line</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwComboRow" id="first_origin_row">
                                        <property name="title" translatable="yes">Origin Station</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwComboRow" id="first_dest_row">
                                        <property name="title" translatable="yes">Destination Station</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow">
                                        <property name="title" translatable="yes">Play Origin Broadcast</property>
                                        <property name="subtitle" translatable="yes">Play departure announcements for starting terminus</property>
                                        <child type="suffix">
                                          <object class="GtkButton" id="first_play_btn">
                                            <property name="label" translatable="yes">Broadcast Origin</property>
                                            <property name="icon-name">media-playback-start-symbolic</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="suggested-action"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="AdwPreferencesGroup">
                                    <property name="title" translatable="yes">Terminus Arrival Broadcast</property>
                                    <property name="description" translatable="yes">Terminus arrival notice and reminder to take all belongings</property>
                                    <child>
                                      <object class="AdwComboRow" id="terminus_station_row">
                                        <property name="title" translatable="yes">Terminus Station</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow">
                                        <property name="title" translatable="yes">Play Terminus Broadcast</property>
                                        <property name="subtitle" translatable="yes">Play final arrival notice</property>
                                        <child type="suffix">
                                          <object class="GtkButton" id="terminus_play_btn">
                                            <property name="label" translatable="yes">Broadcast Terminus</property>
                                            <property name="icon-name">media-playback-start-symbolic</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="suggested-action"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="AdwPreferencesGroup" id="quick_clips_group">
                                    <property name="title" translatable="yes">Instant Broadcast Clips</property>
                                    <property name="description" translatable="yes">Instant single broadcast clips defined by current pack</property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>

                      </object>
                    </property>
                  </object>
                </child>

                <!-- Page B: Empty State (No packs installed) -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">empty</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="empty_status_page">
                        <property name="icon-name">audio-speakers-symbolic</property>
                        <property name="title" translatable="yes">No Announcement Packs Added</property>
                        <property name="description" translatable="yes">Import a ZIP announcement pack containing pack.json to start simulating</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="halign">center</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkButton" id="empty_import_btn">
                                <property name="label" translatable="yes">Import Pack (.zip)</property>
                                <property name="icon-name">list-add-symbolic</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="empty_open_folder_btn">
                                <property name="label" translatable="yes">Open Packs Folder</property>
                                <property name="icon-name">folder-open-symbolic</property>
                                <style>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </property>

        <!-- Bottom Player Bar -->
        <child type="bottom">
          <object class="GtkBox" id="bottom_player_bar">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkSeparator"/>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">10</property>
                <property name="margin-top">10</property>
                <property name="margin-bottom">10</property>
                <property name="margin-start">16</property>
                <property name="margin-end">16</property>
                <child>
                  <object class="GtkButton" id="bottom_mute_btn">
                    <property name="icon-name">audio-volume-high-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Mute / Unmute</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">True</property>
                    <property name="spacing">4</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkLabel" id="bottom_title_label">
                            <property name="label" translatable="yes">Idle Ready</property>
                            <property name="halign">start</property>
                            <property name="hexpand">True</property>
                            <property name="ellipsize">end</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="bottom_route_label">
                            <property name="label" translatable="yes"></property>
                            <property name="halign">end</property>
                            <property name="ellipsize">end</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="bottom_counter_label">
                            <property name="label"></property>
                            <property name="halign">end</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="bottom_subtitle_label">
                        <property name="label" translatable="yes">Select broadcast content above and click play</property>
                        <property name="halign">start</property>
                        <property name="ellipsize">end</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkProgressBar" id="bottom_progress">
                        <property name="fraction">0.0</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="bottom_pause_btn">
                    <property name="icon-name">media-playback-pause-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Pause / Resume</property>
                    <property name="sensitive">False</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="circular"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="bottom_skip_btn">
                    <property name="icon-name">media-skip-forward-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Skip to next segment</property>
                    <property name="sensitive">False</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="circular"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="bottom_stop_btn">
                    <property name="icon-name">media-playback-stop-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Stop playback</property>
                    <property name="sensitive">False</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="circular"/>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Import Pack (.zip)...</attribute>
        <attribute name="action">win.import_pack</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Open Packs Folder</attribute>
        <attribute name="action">win.open_packs_dir</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Delete Packs...</attribute>
        <attribute name="action">win.delete_pack</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">About NextStop</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>